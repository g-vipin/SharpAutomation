{
    "Environment": {
        "Name": "Dev"
    },
    "BrowserSettings": {
        "Browser": "Chrome",
        "BaseUrl": "https://www.saucedemo.com/",
        "Headless": true,
        "TimeoutSec": 10
    },
    "ApiSettings": {
        "BaseUrl": "http://localhost:7035/api/CarPrice",
        "ContentType": "application/json",
        "TimeoutSec": 10,
        "Auth": {
            "Scheme": "None"
        },
        "Resilience": {
            "RetryCount": 3,
            "RetryBaseDelayMilliseconds": 250,
            "TimeoutSeconds": 30,
            "CircuitBreakerFailuresBeforeBreak": 5,
            "CircuitBreakerBreakSeconds": 30
        },
        "Microservices": {
            "InventoryService": {
                "BaseUrl": "http://localhost:7035/api/inventory/",
                "ContentType": "application/json",
                "TimeoutSec": 10,
                "Auth": {
                    "Scheme": "Bearer",
                    "Token": ""
                }
            },
            "PricingService": {
                "BaseUrl": "http://localhost:7035/api/pricing/",
                "ContentType": "application/json",
                "TimeoutSec": 10,
                "Auth": {
                    "Scheme": "None"
                }
            }
        }
    }
}
